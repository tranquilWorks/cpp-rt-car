function(rtfw_add_golden_cuda_real target source)
    find_package(CUDAToolkit REQUIRED)
    if(NOT CUDAToolkit_NVCC_EXECUTABLE)
        message(FATAL_ERROR "Golden CUDA kernel requires the optional nvcc compiler")
    endif()
    set(ptx "${CMAKE_CURRENT_BINARY_DIR}/${target}.ptx")
    add_custom_command(OUTPUT "${ptx}"
        COMMAND "${CUDAToolkit_NVCC_EXECUTABLE}" --ptx -arch=compute_75 "${source}/physics.cu" -o "${ptx}"
        DEPENDS "${source}/physics.cu" VERBATIM)
    add_custom_target(${target}_kernel DEPENDS "${ptx}")
    set(driver_target ${target}_driver)
    add_executable(${driver_target} "${source}/real.cpp")
    add_dependencies(${driver_target} ${target}_kernel)
    target_compile_definitions(${driver_target} PRIVATE RTFW_GOLDEN_CUDA_PTX_PATH="${ptx}")
    target_link_libraries(${driver_target} PRIVATE rtfw::runtime rtfw::cuda_backend rtfw::cuda_driver CUDA::cuda_driver)
    if(WIN32)
        target_link_libraries(${driver_target} PRIVATE psapi)
    endif()
    add_executable(${target} "${source}/native_launcher.cpp")
    target_compile_features(${target} PRIVATE cxx_std_20)
    target_compile_definitions(${target} PRIVATE RTFW_GOLDEN_CUDA_DRIVER_PATH="$<TARGET_FILE:${driver_target}>")
    target_link_libraries(${target} PRIVATE ${CMAKE_DL_LIBS})
    add_dependencies(${target} ${driver_target})
    add_test(NAME ${target}_help COMMAND ${target} --help)
endfunction()
