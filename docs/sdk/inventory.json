  "entries": [
    {
      "header": "rt/runtime.hpp",
      "label": "rt::Runtime",
      "pattern": "^class Runtime \\{",
      "note": "Configure and finalize before start; keep borrowed owners alive until checked stop succeeds."
    },
    {
      "header": "rt/runtime.hpp",
      "label": "Runtime::configure",
      "pattern": "\\bStatus configure\\(",
      "note": "Control-plane configuration; validate capacities and policy before finalization."
    },
    {
      "header": "rt/runtime.hpp",
      "label": "Runtime::finalize",
      "pattern": "\\bStatus finalize\\(",
      "note": "Compile and reserve resources; inspect failure before admitting frames."
    },
    {
      "header": "rt/runtime.hpp",
      "label": "Runtime::start",
      "pattern": "\\bStatus start\\(",
      "note": "Startup must complete before frame admission; borrowed owners already exist."
    },
    {
      "header": "rt/runtime.hpp",
      "label": "Runtime::step",
      "pattern": "\\bStatus step\\(",
      "note": "Explicit frame context, bounded callbacks and checked status; failure may leave application effects."
    },
    {
      "header": "rt/runtime.hpp",
      "label": "Runtime::stop",
      "pattern": "\\bStatus stop\\(",
      "note": "Retain unresolved borrowed resources on failure and retry; destruction is not recovery."
    },
    {
      "header": "rt/runtime.hpp",
      "label": "HostExecutorAdapter",
      "pattern": "^struct HostExecutorAdapter \\{",
      "note": "Copied accepted jobs execute exactly once; opaque completion/scratch identities remain borrowed."
    },
    {
      "header": "rt/runtime.hpp",
      "label": "RuntimeClock",
      "pattern": "^class RuntimeClock \\{",
      "note": "A monotonic clock remains host-owned and outlives Runtime."
    },
    {
      "header": "rt/runtime.hpp",
      "label": "RateExecutionPolicy",
      "pattern": "^struct RateExecutionPolicy \\{",
      "note": "Explicit finite release/dispatch capacities; logical rates are not physical deadlines."
    },
    {
      "header": "rt/runtime.hpp",
      "label": "LiveControlPolicy",
      "pattern": "^struct LiveControlPolicy \\{",
      "note": "Fixed mailbox/producer/record/payload budgets; application apply and side-effect recovery remain external."
    },
    {
      "header": "rt/runtime.hpp",
      "label": "SampledIoChannelRegistration",
      "pattern": "^struct SampledIoChannelRegistration \\{",
      "note": "Declared encoding, clock, freshness and safety policy; accepted submission is not an acknowledged safe state."
    },
    {
      "header": "rt/runtime.hpp",
      "label": "Runtime::checkpoint_size",
      "pattern": "\\bStatus checkpoint_size\\(",
      "note": "Size caller-owned storage before writing; registered state is not an arbitrary process snapshot."
    },
    {
      "header": "rt/runtime.hpp",
      "label": "Runtime::replay_active",
      "pattern": "\\bStatus replay_active\\(",
      "note": "Use a compatible trusted artifact and deterministic mock/loopback providers."
    },
    {
      "header": "rt/runtime.hpp",
      "label": "Runtime::replay_live_control",
      "pattern": "\\bStatus replay_live_control\\(",
      "note": "Payload-bearing artifacts are explicitly trusted; v2 is opt-in for admission history."
    },
    {
      "header": "rt/config.hpp",
      "label": "RuntimeConfig",
      "pattern": "^struct RuntimeConfig \\{",
      "note": "All capacities are explicit; portable defaults do not establish RT qualification."
    },
    {
      "header": "rt/config.hpp",
      "label": "MemoryProvider",
      "pattern": "^struct MemoryProvider \\{",
      "note": "Provider tokens and arenas remain live through failed rollback/stop; report truthful observations."
    },
    {
      "header": "rt/device.hpp",
      "label": "HalV2BackendApi",
      "pattern": "^struct HalV2BackendApi \\{",
      "note": "Capability and lifecycle contract; optional extensions do not imply physical support."
    },
    {
      "header": "rt/status.hpp",
      "label": "Status",
      "pattern": "^enum class Status :",
      "note": "Check every lifecycle and frame result; status_message supplies stable human-readable categories."
    },
    {
      "header": "rt/sdk.hpp",
      "label": "ConfigBuilder",
      "pattern": "^class ConfigBuilder final",
      "note": "Optional helpers delegate to raw validation; no implicit capacity or hidden Runtime lifetime."
    },
    {
      "header": "rt/sdk.hpp",
      "label": "GraphBuilder",
      "pattern": "^class GraphBuilder final",
      "note": "Typed registration remains bounded and explicit."
    },
    {
      "header": "rt/sdk.hpp",
      "label": "CheckedStopGuard",
      "pattern": "^class CheckedStopGuard final",
      "note": "Explicit checked stop/retry is required; unresolved destructor cleanup terminates."
    }
